# Copy to .env for local settings. Never commit real credentials.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/cafes.sqlite
SYNC_TIMEZONE=Europe/Paris

# Sources are enabled when their adapters are implemented and verified.
PARIS_DATA_ENABLED=false

# IGN pedestrian routing works without a key. ORS is an optional alternative.
# Public transport requires a PRIM key (server only).
ORS_API_KEY=
PRIM_API_KEY=

# npm run sync:watch uses this interval, with a minimum of 30 minutes.
SYNC_INTERVAL_MINUTES=180

# Automatic event translations: MyMemory by default, without a key.
# Optional self-hosted/paid LibreTranslate server (local Node service only).
TRANSLATION_PROVIDER=mymemory
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
